{
  "name": "dsh-claude-codex-team",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./headless": "./headless.js"
  },
  "description": "Configurable multi-provider role board and Codex workers for DeepSeek Harness, with optional local dots control",
  "license": "MIT",
  "scripts": {
    "test": "node --test test.mjs"
  }
}
